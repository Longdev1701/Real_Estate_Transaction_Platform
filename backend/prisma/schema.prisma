generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum PropertyType {
  HOUSE
  APARTMENT
  LAND
  ROOM
  VILLA
  OFFICE
  SHOPHOUSE
  WAREHOUSE
}

enum PostType {
  SELL
  RENT
}

enum PostStatus {
  ACTIVE
  HIDDEN
  BANNED
}

enum MessageType {
  TEXT
  IMAGE
}

enum NotificationType {
  MESSAGE
  POST
  REPORT
  SYSTEM
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum AppealStatus {
  NONE
  PENDING
  REVIEWED
}

enum SystemLogModule {
  AUTH
  USER
  POST
  REPORT
  ADMIN
  SYSTEM
  STORAGE
}

enum SystemLogSeverity {
  INFO
  WARNING
  SECURITY
  ERROR
}

enum SystemLogStatus {
  SUCCESS
  FAILED
  BLOCKED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  phone        String?
  avatarUrl    String?
  address      String?
  bio          String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  posts               PropertyPost[]
  sentMessages        Message[]
  notifications       Notification[]
  reports             Report[]
  savedPosts          SavedPost[]
  likedPosts          PostLike[]
  refreshTokens       RefreshToken[]
  systemLogs          SystemLog[]
  comments            Comment[]
  commentReplyTargets Comment[]      @relation("CommentReplyTarget")

  buyerConversations  Conversation[] @relation("BuyerConversation")
  sellerConversations Conversation[] @relation("SellerConversation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([role, createdAt(sort: Desc)])
}

model PropertyPost {
  id String @id @default(cuid())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  title       String
  description String

  price Float
  area  Float

  address  String
  city     String
  district String
  ward     String?

  latitude  Float
  longitude Float

  propertyType PropertyType
  postType     PostType
  status       PostStatus   @default(ACTIVE)

  images        PropertyImage[]
  conversations Conversation[]
  reports       Report[]
  savedBy       SavedPost[]
  likes         PostLike[]
  comments      Comment[]
  features      PropertyPostFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([status, createdAt(sort: Desc)])
}

model PropertyImage {
  id String @id @default(cuid())

  postId String
  post   PropertyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  imageUrl String
  caption  String?
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([postId])
}

model Conversation {
  id String @id @default(cuid())

  buyerId String
  buyer   User   @relation("BuyerConversation", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("SellerConversation", fields: [sellerId], references: [id], onDelete: Cascade)

  postId String
  post   PropertyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  messages Message[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedByIds String[] @default([])

  @@unique([buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([postId])
  @@index([buyerId, updatedAt(sort: Desc)])
  @@index([sellerId, updatedAt(sort: Desc)])
}

model Message {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content     String
  messageType MessageType @default(TEXT)

  isRead   Boolean @default(false)
  isEdited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([conversationId])
  @@index([senderId])
  @@index([conversationId, createdAt(sort: Desc)])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  content String

  type   NotificationType
  isRead Boolean          @default(false)

  relatedId String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model Report {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  postId String
  post   PropertyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  reason      String
  description String?

  status ReportStatus @default(PENDING)

  appealStatus   AppealStatus @default(NONE)
  appealMessage  String?
  appealEvidence String?
  appealedAt     DateTime?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([reporterId])
  @@index([postId])
  @@index([status, createdAt(sort: Desc)])
  @@index([appealStatus, createdAt(sort: Desc)])
}

model SystemLog {
  id String @id @default(cuid())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  module      SystemLogModule
  action      String
  targetType  String?
  targetId    String?
  description String?
  severity    SystemLogSeverity @default(INFO)
  status      SystemLogStatus   @default(SUCCESS)
  ipAddress   String?
  userAgent   String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([module])
  @@index([targetType])
  @@index([createdAt])
  @@index([module, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
}

model SavedPost {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   PropertyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
}

model PostLike {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String
  post   PropertyPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, createdAt(sort: Desc)])
}

model RefreshToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([revokedAt])
  @@index([expiresAt])
}

model Comment {
  id            String       @id @default(cuid())
  postId        String
  post          PropertyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  parentId      String?
  parent        Comment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]    @relation("CommentReplies")
  replyToUserId String?
  replyToUser   User?        @relation("CommentReplyTarget", fields: [replyToUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@index([replyToUserId])
  @@index([postId, parentId, createdAt])
  @@index([parentId, createdAt])
}

model PropertyFeature {
  id            String         @id @default(cuid())
  name          String         @unique
  icon          String?
  description   String?
  category      String?
  propertyTypes PropertyType[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  posts PropertyPostFeature[]
}

model PropertyPostFeature {
  postId    String
  post      PropertyPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  featureId String
  feature   PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([postId, featureId])
  @@index([postId])
  @@index([featureId])
}

